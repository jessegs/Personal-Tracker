ANTHROPIC_API_KEY=your_api_key_here
PORT=3000

# Invite code required for new account signups.
# Defaults to a fallback value if unset; override here for stronger security.
INVITE_CODE=F3Sienna

# Set to "true" when serving over HTTPS so session cookies get the Secure flag.
# SECURE_COOKIES=true

# Strava integration (optional).
# To enable "Push to Strava", register an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to your domain (e.g., bmotracker.cc).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# The base URL the Strava OAuth callback redirects to. Must match what you
# tell Strava (e.g., https://bmotracker.cc). On local dev: http://localhost:3000
STRAVA_REDIRECT_BASE=https://bmotracker.cc
